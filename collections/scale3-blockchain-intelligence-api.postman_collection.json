        {
          "id": "b935fb85-97fc-4cc0-99d3-47913cf9da84",
          "name": "Get node updates",
          "request": {
            "name": "Get node updates",
            "description": {
              "content": "Query node update intelligence for a specific chain and network and get the latest node software updates for that chain. Supports advanced filtering, sorting, field selection and pagination via query parameters. Requires an API key.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "node_updates"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "chain",
                  "value": "<string>",
                  "description": "(Required) Blockchain identifier. Supported values include aptos, algo, arb, avax, base, bnb/bsc, link, btc, bch, ada, tia, celo, atom, cro, dash, doge, eos, eth, etc, ftm, fil, flr, flow, harmony, hbar, hnt, icp, inj, kava, ksm, ltc, mina, near, op, dot, polygon, xrp, sei, sol, stx, xlm, sui, xtz, trx, ton, vet, zec."
                },
                {
                  "disabled": false,
                  "key": "category",
                  "value": "<string>",
                  "description": "Node update category."
                },
                {
                  "disabled": false,
                  "key": "repo_name",
                  "value": "<string>",
                  "description": "Name of repository that contains the update code."
                },
                {
                  "disabled": false,
                  "key": "tag",
                  "value": "<string>",
                  "description": "Node update tag. The tag contains the update version."
                },
                {
                  "disabled": false,
                  "key": "network",
                  "value": "<string>",
                  "description": "Node update network."
                },
                {
                  "disabled": false,
                  "key": "client",
                  "value": "<string>",
                  "description": "Node update client depending on the chain. For chains with no client the default value is the chain itself (e.g. geth, lighthouse, sui)."
                },
                {
                  "disabled": false,
                  "key": "version",
                  "value": "<string>",
                  "description": "Version of the node update."
                },
                {
                  "disabled": false,
                  "key": "priority",
                  "value": "<string>",
                  "description": "Priority/severity level of the node update."
                },
                {
                  "disabled": false,
                  "key": "breaking_changes",
                  "value": "<boolean>",
                  "description": "Whether the update has breaking changes."
                },
                {
                  "disabled": false,
                  "key": "required_for_upcoming_upgrade",
                  "value": "<boolean>",
                  "description": "Whether the update is required for an upcoming network upgrade."
                },
                {
                  "disabled": false,
                  "key": "page_size",
                  "value": "<integer>",
                  "description": "Size of a single page i.e. how many records to send back in the response."
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "<integer>",
                  "description": "Page number."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
