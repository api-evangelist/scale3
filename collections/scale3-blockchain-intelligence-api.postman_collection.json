          "name": "Get network feed",
          "request": {
            "name": "Get network feed",
            "description": {
              "content": "Query the network intelligence feed for a specific chain and network and get the latest announcements (aggregated from Discord and other channels) for that chain. Supports filtering by label and client, and pagination. Requires an API key.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "feed"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "chain",
                  "value": "<string>",
                  "description": "(Required) Blockchain identifier. See getNodeUpdates for the full list of supported chains."
                },
                {
                  "disabled": false,
                  "key": "labels",
                  "value": "<string>",
                  "description": "Type of feed. One of announcement, general information, time sensitive, software upgrade, problem, needs action."
                },
                {
                  "disabled": false,
                  "key": "network",
                  "value": "<string>",
                  "description": "Network."
                },
                {
                  "disabled": false,
                  "key": "clients",
                  "value": "<string>",
                  "description": "Array of clients this feed corresponds to depending on the chain."
                },
                {
                  "disabled": false,
                  "key": "clients",
                  "value": "<string>",
                  "description": "Array of clients this feed corresponds to depending on the chain."
                },
                {
                  "disabled": false,
                  "key": "page_size",
